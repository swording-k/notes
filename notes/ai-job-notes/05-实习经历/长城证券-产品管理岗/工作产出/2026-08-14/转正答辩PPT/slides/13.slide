<Slide style={{ width: '1280px', height: '720px', padding: '28px 72px', background: '#FFFFFF' }}>
  <Box style={{ height: 64 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E3A8A' }}>当前进展：三层都已推进</Text>
  </Box>
  <Box style={{ flexDirection: 'row', marginTop: 20, gap: 28, height: 540 }}>
    {[
      { t: 'Aily 平台版', s: '已上线验证', c: '#16A34A', d: 'F1–F13 全部落地，群聊实测通过（见能力演示页）' },
      { t: '产品操作文档', s: '已写齐', c: '#16A34A', d: '群里怎么用、@指令、识别规则，团队可直接照着用' },
      { t: '自研 / 自建版', s: '探索中', c: '#F97316', d: 'Codex 自部署方案尝试中，验证可迁移性' },
    ].map((x, i) => (
      <Box key={i} style={{ flex: 1, background: '#F8FAFC', borderRadius: 16, padding: 24, borderTop: `6px solid ${x.c}`, justifyContent: 'space-between' }}>
        <Box>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E293B' }}>{x.t}</Text>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 12 }}>
            <Box style={{ width: 12, height: 12, borderRadius: 6, background: x.c }} />
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: x.c }}>{x.s}</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#475569', lineHeight: 1.6, marginTop: 16 }}>{x.d}</Text>
      </Box>
    ))}
  </Box>
</Slide>
