<Slide style={{ width: '1280px', height: '720px', padding: '28px 72px', background: '#FFFFFF' }}>
  <Box style={{ height: 64 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E3A8A' }}>核心能力：在群里，它真的能干活</Text>
  </Box>
  <Box style={{ flexDirection: 'row', marginTop: 12, gap: 36, height: 560 }}>
    <Box style={{ width: '42%', gap: 16, justifyContent: 'center' }}>
      <Image src="assets/cap_decision.png" style={{ width: 460, height: 250, objectFit: 'contain', borderRadius: 10, border: '1px solid #E2E8F0' }} />
      <Image src="assets/cap_requirement.png" style={{ width: 460, height: 240, objectFit: 'contain', borderRadius: 10, border: '1px solid #E2E8F0' }} />
    </Box>
    <Box style={{ width: '58%', gap: 18, justifyContent: 'center' }}>
      {[
        { t: '① 自动识别需求，忽略闲聊', d: '群聊里正常聊项目才记录，喝水摸鱼不扰' },
        { t: '② 识别决策 / 开项目 / 分配工时', d: '一句话触发建项目、派任务、记决策' },
        { t: '③ 报错可提醒自优化', d: '理解错了 @一下，它自己纠错补全' },
        { t: '④ @一下做低频操作', d: '查状态、改状态、问进度，随叫随到' },
      ].map((c, i) => (
        <Box key={i} style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start', background: '#F8FAFC', borderRadius: 12, padding: 16 }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>{c.t}</Text>
          <Text style={{ fontSize: 16, color: '#64748B', marginTop: 2, lineHeight: 1.5 }}>{c.d}</Text>
        </Box>
      ))}
      <Box style={{ background: '#FEF3C7', borderRadius: 12, padding: 14 }}>
        <Text style={{ fontSize: 16, color: '#B45309', lineHeight: 1.5 }}>下图为群聊实测截图：识别需求、决策开项目、分配工时、报错自优化均已验证通过。</Text>
      </Box>
    </Box>
  </Box>
</Slide>
